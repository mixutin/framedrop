{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "framedrop": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "-m",
        "montage_studio",
        "mcp"
      ],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "PYTHONPATH": "${PLUGIN_ROOT}"
      }
    }
  }
}
